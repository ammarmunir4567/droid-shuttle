{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droid Shuttle",
  "version": "0.1.0",
  "identifier": "ai.arqanum.droidshuttle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Droid Shuttle",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/ai.arqanum.droidshuttle/**",
          "$HOME/Pictures/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "signingIdentity": "-" },
    "externalBin": ["binaries/adb"],
    "resources": { "binaries/adb-NOTICE.txt": "licenses/adb-NOTICE.txt", "resources/NOTICE.md": "licenses/NOTICE.md" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}